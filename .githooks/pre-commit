#!/usr/bin/env bash
# Pre-commit hook: gofmt + go vet + golangci-lint
#
# Install once per clone:
#   make hooks
set -euo pipefail

echo "pre-commit: gofmt..."
# Format and re-stage ONLY the Go files already staged for this commit.
# A bare `gofmt -w . && git add -u` stages every tracked modification in the
# working tree, so an unrelated file someone else is mid-edit on gets swept
# into this commit: selective `git add` cannot defend against it.
staged_go="$(git diff --cached --name-only --diff-filter=ACM -- '*.go')"
if [ -n "$staged_go" ]; then
  printf '%s\n' "$staged_go" | xargs -r gofmt -w --
  printf '%s\n' "$staged_go" | xargs -r git add --
fi

echo "pre-commit: go vet..."
go vet ./...

if command -v golangci-lint &>/dev/null; then
  echo "pre-commit: golangci-lint..."
  golangci-lint run ./...
else
  echo "pre-commit: golangci-lint not found, skipping"
  echo "  Install: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

echo "pre-commit: OK"
